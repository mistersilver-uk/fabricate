node_modules/
dist/
build/
# Opt-in bundle-size visualizer report (npm run build:analyze, issue #146)
stats.html
*.log
.DS_Store
.vscode/
# JetBrains AIR agent scratch. The tool excludes this through its own file under AppData, which
# only git can see -- so without an entry here every repo-level tool that walks the tree (the
# Markdown gate among them) lints a developer's scratch plans and fails only on their machine.
.air/
*.zip
# Foundry e2e: ignore runtime data but track world fixtures
.foundry-e2e/worlds/*/data/
.foundry-e2e/worlds/*/backups/
# Downloaded game systems (fetched by scripts/foundry-fetch-systems.mjs)
.foundry-e2e/systems/
# Previously-fetched game-system releases, kept per version so switching smoke arms
# (npm run test:foundry:v13) is a local copy rather than a repeat ~50 MB download.
# A SIBLING of systems/ rather than a subdirectory of it because foundry-setup-data.mjs
# installs every directory it finds under systems/ into the container as a game system —
# a cache nested there would be installed as a second, bogus one. Never commit a game system.
.foundry-e2e/systems-cache/
# Foundry installation cache (avoids re-downloading)
.foundry-e2e/cache/
# Harvested Foundry window chrome for the View Lab (proprietary; never commit)
/.foundry-chrome/
# Class-2 benchmark run records: wall clock + heap + machine envelope (issue 1071).
# Machine-DEPENDENT and never asserted, so they must not be committed — the committed,
# machine-invariant half lives in benchmarks/baselines/ and is tracked.
/.benchmarks/
# Class-2 Foundry perf run records and Chrome traces (issue 1073). Wall clock and heap measured
# inside a live Foundry: machine-, build- and browser-dependent, never asserted, never committed.
# Kept apart from issue 1071's /.benchmarks/ on purpose — these two sets of numbers have DIFFERENT
# comparability rules, and one directory would invite comparing across them.
/.foundry-perf/
# Assembled data directory for Docker mount (contains symlinks)
.foundry-e2e/data/
test-results/
.env.foundry
# Claude-generated project docs
COMPETITIVE_ANALYSIS.md
CONTENT_PACKS.md
PLAN.md
# Content pack specifications (premium, not for public repo)
content-packs/
/.claude/settings.local.json
/.worktrees/
tmp
# Foundry LevelDB pack runtime files (rewritten on every pack open)
packs/*/LOG
packs/*/LOG.old
packs/*/LOCK
packs/*/*.log
design/
ui-screenshot-artifact/
node_modules
