    "path": "src/ui/svelte/components/ManagerToolbar.svelte",
    "props": {
      "ariaLabel": "Recipe filters"
    },
    "content": [
      {
        "tag": "div",
        "attrs": { "class": "manager-recipe-filter-row" },
        "children": [
