    "content": [
      {
        "tag": "label",
        "children": [
          { "tag": "span", "text": "Category" },
          {
            "tag": "select",
            "attrs": { "aria-label": "Category" },
            "children": [
              { "tag": "option", "text": "Leave unchanged" },
              { "tag": "option", "text": "Metal" },
              { "tag": "option", "text": "Reagent" }
            ]
          }
        ]
      },
      {
