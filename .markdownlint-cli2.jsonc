{
  // Lint every authored Markdown file.
  "globs": ["**/*.md"],
  // Anything git ignores, this ignores. The glob is `**/*.md`, so without this the gate goes
  // red on whatever a developer's own checkout happens to contain -- a scratch plan under
  // `.air/`, a design brief, a capture's staging file, a Python virtualenv, a sibling worktree.
  // None of it exists in CI, so the gate failed only for the person running it locally, which
  // is the worst possible audience for a false red.
  //
  // This replaces a hand-maintained list that had to grow every time a new ignored directory
  // appeared, and had already drifted: it carried entries for paths that are NOT gitignored
  // while missing several that are.
  "gitignore": true,
  // The remainder, which git does NOT ignore and which therefore still need naming. Keep this
  // list short: an entry here is a file the repository tracks and deliberately exempts.
  "ignores": [
    // Fixture world for the Foundry end-to-end harness; its Markdown is Foundry's, not ours.
    ".foundry-e2e",
    // The View Lab / screenshot publisher writes a `.pr-body.md` staging file here.
    "ui-screenshot-artifact",
    // Generated from commit history by the release tooling.
    "CHANGELOG.md"
  ],
  // One-sentence-per-line rule (markdownlint-sentences-per-line, parser: "none").
  "customRules": ["markdownlint-sentences-per-line"],
  "config": {
    "default": true,
    // line-length: conflicts with one-sentence-per-line (sentences become long single lines).
    "MD013": false,
    // duplicate headings: these structured docs reuse section headings (e.g. "Why",
    // "Tasks") under different parents; only flag duplicates among siblings.
    "MD024": { "siblings_only": true },
    // single H1: docs/ Jekyll pages carry a front-matter `title:` plus a body `# H1`;
    // don't count the front-matter title so the single body H1 is the page title.
    "MD025": { "front_matter_title": "" },
    // inline HTML: intentional in agent/skill/spec docs (e.g. <details>, comments, tags).
    "MD033": false,
    // first-line H1: many docs are front-matter-led (agent/skill/prompt definitions) or
    // badge-led (README); a mandatory first-line heading fights that convention.
    "MD041": false,
    // table column alignment: not auto-fixable and demands monospace pipe-alignment that is
    // impractical to maintain by hand. MD055 (pipe style) and MD056 (column count) stay on
    // and catch real table breakage.
    "MD060": false,
    // Enforce one sentence per line.
    "markdownlint-sentences-per-line": true
  }
}
