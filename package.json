{
  "name": "fabricate",
  "version": "0.0.0-development",
  "description": "A universal crafting & gathering system for Foundry VTT.",
  "type": "module",
  "scripts": {
    "build": "node scripts/release.js --no-zip",
    "build:analyze": "node scripts/release.js --no-zip --analyze",
    "verify:chunk-split": "node scripts/verify-manager-chunk-split.mjs",
    "dev": "vite serve",
    "setup:dev": "node scripts/setup-dev-module.mjs",
    "setup:dev:dist": "node scripts/setup-dev-module.mjs --dev --force",
    "validate:agents": "node scripts/validate-agent-bindings.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "lint:debt": "node scripts/lint-debt.mjs",
    "lint:svelte": "eslint \"src/**/*.svelte\" --max-warnings=0",
    "lint:svelte:warnings": "node scripts/check-svelte-warnings.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"styles/**/*.{css,scss}\" --max-warnings=0",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:files": "markdownlint-cli2 --no-globs",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "screenshots:ui": "node scripts/ui-pr-screenshot-evidence.mjs collect",
    "screenshots:ui:plan": "node scripts/ui-pr-screenshot-evidence.mjs plan",
    "screenshots:ui:check": "node scripts/ui-pr-screenshot-evidence.mjs check",
    "screenshots:ui:collect": "node scripts/ui-pr-screenshot-evidence.mjs collect",
    "screenshots:ui:publish": "node scripts/ui-pr-screenshot-evidence.mjs publish",
    "screenshots:ui:targets": "node scripts/ui-pr-screenshot-evidence.mjs targets",
    "screenshots:ui:clean": "node scripts/ui-pr-screenshot-evidence.mjs clean",
    "viewlab:chrome:harvest": "node scripts/view-lab-chrome.mjs harvest",
    "viewlab:chrome:verify": "node scripts/view-lab-chrome.mjs verify",
    "viewlab:chrome:status": "node scripts/view-lab-chrome.mjs status",
    "viewlab:chrome:clean": "node scripts/view-lab-chrome.mjs clean",
    "viewlab:chrome:baseline": "node scripts/view-lab-screenshots.mjs chrome",
    "test": "node --conditions=browser --test --test-timeout=300000 \"tests/**/*.test.js\"",
    "test:foundry:install": "playwright install chromium --with-deps",
    "test:foundry:up": "node scripts/foundry-test-up.mjs",
    "test:foundry:run": "node scripts/foundry-test-run.mjs",
    "test:foundry:down": "node scripts/foundry-test-down.mjs",
    "test:foundry": "node scripts/foundry-test.mjs",
    "test:foundry:rc": "node scripts/foundry-test.mjs --profile=rc",
    "test:foundry:ci": "node scripts/foundry-test.mjs --profile=ci",
    "test:foundry:screenshots": "node scripts/foundry-test.mjs --profile=screenshots",
    "test:foundry:v13": "node scripts/foundry-test.mjs --arm=v13 --check=version",
    "test:foundry:v14": "node scripts/foundry-test.mjs --arm=v14 --check=version",
    "test:foundry:perf": "node scripts/foundry-test.mjs --profile=perf --check=perf",
    "release:build": "node scripts/release.js",
    "release:validate": "node scripts/release.js --validate-only",
    "release:s3": "node scripts/release-s3.js",
    "release:s3:dry-run": "node scripts/release-s3.js --dry-run",
    "docs": "cd docs && bundle exec jekyll serve --livereload",
    "docs:install": "cd docs && bundle install",
    "docs:screenshots": "node scripts/docs-screenshots.mjs generate",
    "docs:screenshots:check": "node scripts/docs-screenshots.mjs check",
    "viewlab:index": "node scripts/view-lab-index.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions"
  ],
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@semantic-release/exec": "^7.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unicorn": "^67.0.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.4",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-sentences-per-line": "^0.1.3",
    "playwright": "^1.53.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "semantic-release": "^25.0.3",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "svelte": "^5.0.0",
    "svelte-eslint-parser": "^1.8.0",
    "vite": "^8.0.16"
  },
  "private": true,
  "keywords": [
    "foundryvtt",
    "foundry-vtt",
    "crafting",
    "recipes",
    "system-agnostic"
  ],
  "license": "PolyForm-Noncommercial-1.0.0"
}
